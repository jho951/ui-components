{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    "baseUrl": "./",
    "paths": {
      "@/*": ["*"],
      "@ui/*": ["ui/*"],
      "@hook/*": ["hook/*"],
      "@lib/*": ["lib/*"],
      "@assert/*": ["assert/*"]
    }
  },
  "include": ["./**/*",
    "packages/global.d.ts"
  ],
  "exclude": ["dist",
    "node_modules"]
}
