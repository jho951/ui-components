{
  "name": "@jho951/ui-components",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "sideEffects": ["**/*.css"],

  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",

  "files": [
    "dist",
    "../README.md"
  ],

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },

  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },

  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^18",
    "react-dom": "^18",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },

  "scripts": {
    "build": "tsup && node ../scripts/copy-css.mjs",
    "clean": "rm -rf dist"
  }
}
