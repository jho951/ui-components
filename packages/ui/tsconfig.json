{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "strict": true,
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react", "./node_modules/react"],
      "react-dom": ["./node_modules/@types/react-dom", "./node_modules/react-dom"],
    }
  },
  "include": [
    ".",
    "global.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}